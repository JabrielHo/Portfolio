---
import "leaflet/dist/leaflet.css";
import type { MapMarker } from "../lib/journey";

interface Props {
  markers: MapMarker[];
}

const { markers } = Astro.props;
---

<div
  class="rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-800 h-full"
  role="region"
  aria-label="Interactive map showing work and education locations">
  <div id="leaflet-map" data-markers={JSON.stringify(markers)} style="height: 100%; width: 100%;"></div>
</div>

<style>
  :global(.map-popup) {
    font-family: "Space Grotesk Variable", sans-serif;
    min-width: 180px;
  }
  :global(.map-popup-badge) {
    display: inline-block;
    margin-bottom: 8px;
    padding: 2px 8px;
    border-radius: 9999px;
    background: var(--chip-bg);
    color: var(--chip-text);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  :global(.map-popup-title) {
    margin-bottom: 2px;
    color: var(--text-strong);
    font-size: 14px;
    font-weight: 700;
  }
  :global(.map-popup-subtitle) {
    margin-bottom: 4px;
    color: var(--text-muted);
    font-size: 12px;
  }
  :global(.map-popup-date) {
    color: var(--text-faint);
    font-size: 11px;
  }

  /* Marker dots mirror the pins shown next to journey entries. */
  :global(.map-marker-dot) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-sizing: border-box;
  }
  :global(.mm-work) {
    background: var(--accent);
  }
  :global(.mm-edu) {
    background: transparent;
    border: 2px solid var(--accent);
  }

  :global(.map-failed) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8rem;
  }
</style>

<script>
  import type { Map as LeafletMap, Marker as LeafletMarker } from "leaflet";
  import type { MapMarker } from "../lib/journey";

  // CARTO requires an API key on basemap requests; without one every tile is
  // stamped "API KEY REQUIRED". Get a free key at https://carto.com/basemaps/apikey.
  const CARTO_KEY = import.meta.env.PUBLIC_CARTO_API_KEY;
  const TILE_URL = {
    light: `https://basemaps.cartocdn.com/rastertiles/light_all/{z}/{x}/{y}{r}.png?key=${CARTO_KEY}`,
    dark: `https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png?key=${CARTO_KEY}`,
  };

  const POPUP_CLEARANCE = 140;

  const isDarkMode = () => document.documentElement.classList.contains("dark");
  const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const announceSelection = (id: string | null) =>
    document.dispatchEvent(new CustomEvent("selection-changed", { detail: { id } }));

  const mapEl = document.getElementById("leaflet-map");
  if (mapEl) {
    const pendingSelectEntry = initMap(mapEl).catch((err) => {
      console.error(err);
      mapEl.textContent = "Map unavailable. Refresh to try again.";
      mapEl.classList.add("map-failed");
      return null;
    });
    document.addEventListener("select-entry", async (e) => {
      revealMarkerSpot(mapEl);
      (await pendingSelectEntry)?.(e.detail.id);
    });
  }

  function revealMarkerSpot(el: HTMLElement) {
    const { top, height } = el.getBoundingClientRect();
    const markerY = top + height / 2;
    if (markerY < POPUP_CLEARANCE || markerY > window.innerHeight) el.scrollIntoView({ block: "center" });
  }

  async function initMap(el: HTMLElement) {
    const L = (await import("leaflet")).default;
    const markers: MapMarker[] = JSON.parse(el.dataset.markers || "[]");

    const map = L.map(el, { center: [1.32, 103.85], zoom: 12 });

    const tiles = L.tileLayer(isDarkMode() ? TILE_URL.dark : TILE_URL.light, {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
      maxZoom: 19,
    }).addTo(map);

    new ResizeObserver(() => map.invalidateSize()).observe(el);

    new MutationObserver(() => tiles.setUrl(isDarkMode() ? TILE_URL.dark : TILE_URL.light)).observe(
      document.documentElement,
      { attributes: true, attributeFilter: ["class"] },
    );

    const flyToMarker = (marker: LeafletMarker) => map.flyTo(marker.getLatLng(), 15, { duration: 0.8 });

    const markerById: Record<string, LeafletMarker> = {};
    for (const m of markers) {
      const marker = addMarker(L, map, m);
      marker.on("popupopen", () => {
        flyToMarker(marker);
        announceSelection(m.id);
      });
      marker.on("popupclose", () => announceSelection(null));
      markerById[m.id] = marker;
    }

    return (id: string) => {
      const marker = markerById[id];
      if (marker.isPopupOpen()) flyToMarker(marker);
      else marker.openPopup();
    };
  }

  function addMarker(L: typeof import("leaflet"), map: LeafletMap, m: MapMarker): LeafletMarker {
    const typeLabel = m.type === "work" ? "Work" : "Education";
    const label = `${typeLabel}: ${m.role} at ${m.org}`;

    const icon = L.divIcon({
      className: "custom-marker",
      html: `<div class="map-marker-dot ${m.type === "work" ? "mm-work" : "mm-edu"}" role="img" aria-label="${escapeHtml(label)}"></div>`,
      iconSize: [14, 14],
      iconAnchor: [7, 7],
      popupAnchor: [0, -10],
    });

    const marker = L.marker([m.lat, m.lng], { icon })
      .addTo(map)
      .bindPopup(popupHtml(typeLabel, m), { closeButton: false });

    // Expose the Leaflet-generated container to assistive tech.
    const el = marker.getElement();
    el?.setAttribute("role", "button");
    el?.setAttribute("aria-label", label);

    return marker;
  }

  function popupHtml(typeLabel: string, m: MapMarker): string {
    return `
      <div class="map-popup">
        <span class="map-popup-badge">${typeLabel}</span>
        <div class="map-popup-title">${escapeHtml(m.org)}</div>
        <div class="map-popup-subtitle">${escapeHtml(m.role)}</div>
        <div class="map-popup-date">${escapeHtml(m.date)}</div>
      </div>`;
  }
</script>
