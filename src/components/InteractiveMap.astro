---
import "leaflet/dist/leaflet.css";

interface Marker {
  lat: number;
  lng: number;
  title: string;
  subtitle: string;
  date: string;
  type: "work" | "education";
}

interface Props {
  markers: Marker[];
}

const { markers } = Astro.props;
---

<div
  class="rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-800 h-full"
  role="img"
  aria-label="Interactive map showing work and education locations">
  <div id="leaflet-map" data-markers={JSON.stringify(markers)} style="height: 100%; width: 100%;"></div>
</div>

<style>
  :global(.map-popup) {
    font-family: "Space Grotesk Variable", sans-serif;
    min-width: 180px;
  }
  :global(.map-popup-badge) {
    display: inline-block;
    margin-bottom: 8px;
    padding: 2px 8px;
    border-radius: 9999px;
    background: var(--color-stone-100);
    color: var(--color-stone-600);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  :global(.dark .map-popup-badge) {
    background: var(--color-stone-700);
    color: var(--color-stone-300);
  }
  :global(.map-popup-title) {
    margin-bottom: 2px;
    color: var(--text-strong);
    font-size: 14px;
    font-weight: 700;
  }
  :global(.map-popup-subtitle) {
    margin-bottom: 4px;
    color: var(--text-muted);
    font-size: 12px;
  }
  :global(.map-popup-date) {
    color: var(--text-faint);
    font-size: 11px;
  }

  /* Marker dots mirror the pins shown next to journey entries. */
  :global(.map-marker-dot) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-sizing: border-box;
  }
  :global(.mm-work) {
    background: var(--accent);
  }
  :global(.mm-edu) {
    background: transparent;
    border: 2px solid var(--accent);
  }
</style>

<script>
  import type { Map as LeafletMap, Marker as LeafletMarker } from "leaflet";

  interface MapMarker {
    lat: number;
    lng: number;
    title: string;
    subtitle: string;
    date: string;
    type: "work" | "education";
  }

  // CARTO requires an API key on basemap requests; without one every tile is
  // stamped "API KEY REQUIRED". Get a free key at https://carto.com/basemaps/apikey.
  const CARTO_KEY = import.meta.env.PUBLIC_CARTO_API_KEY;
  const TILE_URL = {
    light: `https://basemaps.cartocdn.com/rastertiles/light_all/{z}/{x}/{y}{r}.png?key=${CARTO_KEY}`,
    dark: `https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png?key=${CARTO_KEY}`,
  };

  const isDarkMode = () => document.documentElement.classList.contains("dark");
  const markerKey = (lat: number, lng: number) => `${lat},${lng}`;

  const mapEl = document.getElementById("leaflet-map");
  if (mapEl) initMap(mapEl);

  async function initMap(el: HTMLElement) {
    const L = (await import("leaflet")).default;
    const markers: MapMarker[] = JSON.parse(el.dataset.markers || "[]");

    const map = L.map(el, { center: [1.32, 103.85], zoom: 12 });

    const tiles = L.tileLayer(isDarkMode() ? TILE_URL.dark : TILE_URL.light, {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
      maxZoom: 19,
    }).addTo(map);

    // Leaflet needs a size hint once the flex/grid layout has settled.
    setTimeout(() => map.invalidateSize(), 0);
    new ResizeObserver(() => map.invalidateSize()).observe(el);

    // Swap the basemap when the site theme toggles.
    new MutationObserver(() => tiles.setUrl(isDarkMode() ? TILE_URL.dark : TILE_URL.light)).observe(
      document.documentElement,
      { attributes: true, attributeFilter: ["class"] },
    );

    const markerByKey: Record<string, LeafletMarker> = {};
    for (const m of markers) {
      markerByKey[markerKey(m.lat, m.lng)] = addMarker(L, map, m);
    }

    // List → map: fly to the selected entry and open its popup.
    document.addEventListener("fly-to-map", (e) => {
      const { lat, lng } = (e as CustomEvent<{ lat: number; lng: number }>).detail;
      map.flyTo([lat, lng], 15, { duration: 0.8 });
      markerByKey[markerKey(lat, lng)]?.openPopup();
    });
  }

  function addMarker(L: typeof import("leaflet"), map: LeafletMap, m: MapMarker): LeafletMarker {
    const typeLabel = m.type === "work" ? "Work" : "Education";
    const label = `${typeLabel}: ${m.title} at ${m.subtitle}`;

    const icon = L.divIcon({
      className: "custom-marker",
      html: `<div class="map-marker-dot ${m.type === "work" ? "mm-work" : "mm-edu"}" role="img" aria-label="${label}"></div>`,
      iconSize: [14, 14],
      iconAnchor: [7, 7],
      popupAnchor: [0, -10],
    });

    const marker = L.marker([m.lat, m.lng], { icon })
      .addTo(map)
      .bindPopup(popupHtml(typeLabel, m), { closeButton: false });

    // Expose the Leaflet-generated container to assistive tech.
    const el = marker.getElement();
    el?.setAttribute("role", "button");
    el?.setAttribute("aria-label", label);

    // Map → list: tell the journey list which entry was clicked.
    marker.on("click", () => {
      document.dispatchEvent(new CustomEvent("map-marker-selected", { detail: { lat: m.lat, lng: m.lng } }));
    });

    return marker;
  }

  function popupHtml(typeLabel: string, m: MapMarker): string {
    return `
      <div class="map-popup">
        <span class="map-popup-badge">${typeLabel}</span>
        <div class="map-popup-title">${m.title}</div>
        <div class="map-popup-subtitle">${m.subtitle}</div>
        <div class="map-popup-date">${m.date}</div>
      </div>`;
  }
</script>
