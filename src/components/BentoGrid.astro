---
import { dateRange, getSortedData, type Data } from "../lib/content";
import type { JourneyEntry, JourneyKind, MapMarker } from "../lib/journey";
import IdentityTile from "./tiles/IdentityTile.astro";
import JourneyTile from "./tiles/JourneyTile.astro";
import ProjectsTile from "./tiles/ProjectsTile.astro";
import CertTile from "./tiles/CertTile.astro";
import InteractiveMap from "./InteractiveMap.astro";

const toEntry = (org: string, role: string, e: Data<"experience"> | Data<"education">): JourneyEntry => ({
  org,
  role,
  date: dateRange(e.startDate, e.endDate),
  highlights: e.highlights,
  lat: e.lat,
  lng: e.lng,
});
const work = (await getSortedData("experience")).map((e) => toEntry(e.company, e.title, e));
const study = (await getSortedData("education")).map((e) => toEntry(e.institution, e.degree, e));

const toMarker =
  (type: JourneyKind) =>
  ({ org, role, date, lat, lng }: JourneyEntry): MapMarker => ({ org, role, date, lat, lng, type });
const markers = [...work.map(toMarker("work")), ...study.map(toMarker("education"))];

const projects = await getSortedData("projects");
const certifications = await getSortedData("certifications");
---

<main id="bento" class="bento">
  <IdentityTile />
  <JourneyTile work={work} study={study} />
  <div class="tile area-map">
    <InteractiveMap markers={markers} />
  </div>
  <div class="side">
    <ProjectsTile projects={projects} />
    <CertTile certifications={certifications} />
  </div>
</main>

<script>
  // Flag scroll lists that have cards hidden below the fold, so the CSS can fade their bottom edge.
  const updateFade = (el: HTMLElement) =>
    el.classList.toggle("has-more", el.scrollTop + el.clientHeight < el.scrollHeight - 2);

  const lists = document.querySelectorAll<HTMLElement>(".stack-scroll");
  const resize = new ResizeObserver((entries) => entries.forEach((e) => updateFade(e.target as HTMLElement)));
  lists.forEach((el) => {
    el.addEventListener("scroll", () => updateFade(el), { passive: true });
    resize.observe(el);
  });
  // Web fonts can change card heights after first paint.
  document.fonts.ready.then(() => lists.forEach(updateFade));
</script>

<style>
  .bento {
    display: grid;
    gap: clamp(0.5rem, 1vw, 1rem);
    padding: clamp(0.75rem, 1.5vw, 1.25rem);
    grid-template-columns: 1.4fr 2.3fr 1.3fr;
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-areas:
      "id      map side"
      "journey map side";
    height: 100dvh;
    overflow: hidden;
  }

  /* Tiles stay layout-agnostic; the grid decides where each one goes. */
  .bento :global(.id-tile) {
    grid-area: id;
  }
  .bento :global(.journey-tile) {
    grid-area: journey;
  }
  .area-map {
    grid-area: map;
    padding: 0;
  }
  .side {
    grid-area: side;
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 1vw, 1rem);
    min-height: 0;
  }

  /* Tablet: map moves beside the intro/journey column, side row drops below. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .bento {
      grid-template-columns: 1.4fr 1.6fr;
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "id      map"
        "journey map"
        "side    side";
      height: auto;
      overflow: visible;
    }
    .area-map {
      min-height: 320px;
    }
  }

  /* Short landscape screens: let the page grow instead of clipping. */
  @media (min-width: 1024px) and (max-height: 720px) {
    .bento {
      height: auto;
      overflow: visible;
    }
  }

  @media (max-width: 1023px) {
    .bento {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas:
        "id"
        "map"
        "journey"
        "side";
      height: auto;
      overflow: visible;
    }
    .area-map {
      height: 300px;
    }
  }
</style>
