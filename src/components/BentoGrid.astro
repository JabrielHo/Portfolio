---
import { getCollection } from "astro:content";
import IdentityTile from "./tiles/IdentityTile.astro";
import JourneyTile from "./tiles/JourneyTile.astro";
import ProjectsTile from "./tiles/ProjectsTile.astro";
import CertTile from "./tiles/CertTile.astro";
import InteractiveMap from "./InteractiveMap.astro";

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;

const experiences = (await getCollection("experience")).sort(byOrder);
const education = (await getCollection("education")).sort(byOrder);
const projects = (await getCollection("projects")).sort(byOrder);
const certifications = (await getCollection("certifications")).sort(byOrder);

const dateRange = (d: { startDate: string; endDate: string }) => `${d.startDate} — ${d.endDate}`;

// One normalized shape for both the timeline list and the map markers.
const work = experiences.map((e) => ({
  org: e.data.company,
  role: e.data.title,
  date: dateRange(e.data),
  highlights: e.data.highlights,
  lat: e.data.lat,
  lng: e.data.lng,
}));
const study = education.map((e) => ({
  org: e.data.institution,
  role: e.data.degree,
  date: dateRange(e.data),
  highlights: e.data.highlights,
  lat: e.data.lat,
  lng: e.data.lng,
}));

type JourneyEntry = (typeof work)[number];
const toMarker = (type: "work" | "education") => (e: JourneyEntry) => ({
  lat: e.lat,
  lng: e.lng,
  title: e.org,
  subtitle: e.role,
  date: e.date,
  type,
});
const markers = [...work.map(toMarker("work")), ...study.map(toMarker("education"))];

const projectItems = projects.map((p) => p.data);
const certItems = certifications.map((c) => c.data);
---

<main id="bento" class="bento">
  <IdentityTile />
  <JourneyTile work={work} study={study} />
  <div class="tile area-map">
    <InteractiveMap markers={markers} />
  </div>
  <div class="side">
    <ProjectsTile projects={projectItems} />
    <CertTile certifications={certItems} />
  </div>
</main>

<script>
  // Flag scroll lists that have cards hidden below the fold, so the CSS can fade their bottom edge.
  const updateFade = (el: HTMLElement) =>
    el.classList.toggle("has-more", el.scrollTop + el.clientHeight < el.scrollHeight - 2);

  const lists = document.querySelectorAll<HTMLElement>(".stack-scroll");
  const resize = new ResizeObserver((entries) => entries.forEach((e) => updateFade(e.target as HTMLElement)));
  lists.forEach((el) => {
    updateFade(el);
    el.addEventListener("scroll", () => updateFade(el), { passive: true });
    resize.observe(el);
  });
  // Web fonts can change card heights after first paint.
  document.fonts.ready.then(() => lists.forEach(updateFade));
</script>

<style>
  .bento {
    display: grid;
    gap: clamp(0.5rem, 1vw, 1rem);
    padding: clamp(0.75rem, 1.5vw, 1.25rem);
    grid-template-columns: 1.4fr 2.3fr 1.3fr;
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-areas:
      "id      map side"
      "journey map side";
    height: 100dvh;
    overflow: hidden;
  }

  /* Tiles stay layout-agnostic; the grid decides where each one goes. */
  .bento :global(.id-tile) {
    grid-area: id;
  }
  .bento :global(.journey-tile) {
    grid-area: journey;
  }
  .area-map {
    grid-area: map;
    padding: 0;
  }
  .side {
    grid-area: side;
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 1vw, 1rem);
    min-height: 0;
  }

  /* Tablet: map moves beside the intro/journey column, side row drops below. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .bento {
      grid-template-columns: 1.4fr 1.6fr;
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "id      map"
        "journey map"
        "side    side";
      height: auto;
      overflow: visible;
    }
    .area-map {
      min-height: 320px;
    }
  }

  /* Short landscape screens: let the page grow instead of clipping. */
  @media (min-width: 1024px) and (max-height: 720px) {
    .bento {
      height: auto;
      overflow: visible;
    }
  }

  /* Mobile: single column, everything stacks. */
  @media (max-width: 1023px) {
    .bento {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas:
        "id"
        "map"
        "journey"
        "side";
      height: auto;
      overflow: visible;
    }
    .area-map {
      height: 300px;
    }
  }
</style>
