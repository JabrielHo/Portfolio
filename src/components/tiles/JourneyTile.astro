---
import type { JourneyEntry, JourneyKind } from "../../lib/journey";

interface Props {
  work: JourneyEntry[];
  study: JourneyEntry[];
}
const { work, study } = Astro.props;

const groups: { label: string; type: JourneyKind; items: JourneyEntry[] }[] = [
  { label: "Experience", type: "work", items: work },
  { label: "Education", type: "education", items: study },
];
---

<section id="journey" class="tile journey-tile" aria-label="Experience and education">
  <div class="stack-scroll">
    {
      groups.map((group) => (
        <div class="group">
          <h2 class="eyebrow">{group.label}</h2>
          <ul role="list" class="entries">
            {group.items.map((item) => (
              <li>
                <button class="map-card" data-lat={item.lat} data-lng={item.lng} title={`Show ${item.org} on map`}>
                  <span class={`marker ${group.type}`} aria-hidden="true" />
                  <span class="card-main">
                    <span class="panel-head">
                      <span class="title-block">
                        <span class="panel-title">{item.org}</span>
                        <span class="panel-subtitle">{item.role}</span>
                      </span>
                      <span class="meta">{item.date}</span>
                    </span>
                    {item.highlights.length > 0 && (
                      <ul class="dash-list highlights">
                        {item.highlights.map((h) => (
                          <li>{h}</li>
                        ))}
                      </ul>
                    )}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .journey-tile {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .group + .group {
    margin-top: 0.9rem;
  }
  .eyebrow {
    margin-bottom: 0.5rem;
  }
  .entries {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* A journey entry is a clickable panel that pans the map. */
  .map-card {
    display: flex;
    gap: 0.6rem;
    width: 100%;
    text-align: left;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--surface-border);
    border-radius: 0.7rem;
    background: var(--surface-bg);
    cursor: pointer;
    transition: all 0.2s;
  }
  .map-card:hover {
    border-color: var(--surface-border-strong);
    background: var(--surface-bg-hover);
  }
  .map-card.is-active {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  /* Map-pin style dot mirroring the markers on the map. */
  .marker {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.3rem;
    border-radius: 50%;
  }
  .marker.work {
    background: var(--accent);
  }
  .marker.education {
    background: transparent;
    border: 2px solid var(--accent);
  }

  .card-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .title-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .highlights {
    margin-top: 0.35rem;
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLButtonElement>("#journey .map-card"));

  function setActive(card: Element | null) {
    cards.forEach((c) => c.classList.remove("is-active"));
    if (card) {
      card.classList.add("is-active");
      card.scrollIntoView({ block: "nearest" });
    }
  }

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      setActive(card);
      document.dispatchEvent(
        new CustomEvent("fly-to-map", {
          detail: { lat: parseFloat(card.dataset.lat || "0"), lng: parseFloat(card.dataset.lng || "0") },
        }),
      );
    });
  });

  document.addEventListener("map-marker-selected", (e) => {
    const { lat, lng } = e.detail;
    const card = document.querySelector(`#journey .map-card[data-lat="${lat}"][data-lng="${lng}"]`);
    setActive(card);
  });
</script>
