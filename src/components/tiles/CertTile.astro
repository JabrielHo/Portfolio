---
import { dateRange, type Data } from "../../lib/content";
import ExternalLinkIcon from "../icons/ExternalLinkIcon.astro";

interface Props {
  certifications: Data<"certifications">[];
}
const { certifications } = Astro.props;
---

<section class="tile cert-tile" aria-label="Certifications">
  <h2 class="eyebrow">Certification</h2>
  <div class="stack-scroll">
    {
      certifications.map((c) => (
        <article class="panel">
          <div class="panel-head">
            <div>
              <h3 class="panel-title">{c.title}</h3>
              <p class="panel-subtitle">{c.issuer}</p>
            </div>
            <span class="meta">{dateRange(c.issueDate, c.expiryDate)}</span>
          </div>

          {c.description && <p class="description">{c.description}</p>}

          {c.link && (
            <a class="link" href={c.link} target="_blank" rel="noopener noreferrer">
              <ExternalLinkIcon /> <span>View credential</span>
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .cert-tile {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 0;
  }
  .description {
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: 100%;
    margin-top: 0.7rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--divider);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .link:hover {
    color: var(--text-strong);
  }
</style>
