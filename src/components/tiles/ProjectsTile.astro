---
import GitHubIcon from "../icons/GitHubIcon.astro";
import ExternalLinkIcon from "../icons/ExternalLinkIcon.astro";

interface Project {
  title: string;
  course?: string;
  description: string[];
  tags: string[];
  github?: string;
  link?: string;
}
interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---

<section class="tile projects-tile" aria-label="Projects">
  <h2 class="eyebrow">Projects</h2>
  <div class="stack-scroll">
    {
      projects.map((p) => (
        <article class="panel">
          <div class="panel-head">
            <div>
              <h3 class="panel-title">{p.title}</h3>
              {p.course && <p class="panel-subtitle">{p.course}</p>}
            </div>
          </div>

          <ul class="dash-list description">
            {p.description.map((d) => (
              <li>{d}</li>
            ))}
          </ul>

          <div class="tags">
            {p.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>

          {(p.github || p.link) && (
            <div class="links">
              {p.github && (
                <a href={p.github} target="_blank" rel="noopener noreferrer">
                  <GitHubIcon /> <span>Source</span>
                </a>
              )}
              {p.link && (
                <a href={p.link} target="_blank" rel="noopener noreferrer">
                  <ExternalLinkIcon /> <span>Live demo</span>
                </a>
              )}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects-tile {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 0;
  }
  .description {
    margin: 0.5rem 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .tag {
    font-size: 0.6rem;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-stone-300);
    color: var(--color-stone-600);
  }
  :global(.dark) .tag {
    border-color: var(--color-stone-700);
    color: var(--color-stone-300);
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.7rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--divider);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .links a:hover {
    color: var(--text-strong);
  }
</style>
